# Пример файла .env для локальной разработки
# Скопируйте и переименуйте в .env.local или .env.development

# Public Supabase values used by the browser application.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never put SUPABASE_SERVICE_ROLE_KEY or SUPABASE_JWT_SECRET in a Vite-prefixed
# variable: every VITE_* value is embedded in the public browser bundle.

# Переменные приложения
VITE_APP_NAME=FeelMe36
